# Copy to .env.local and adjust. Values with the EXPO_PUBLIC_ prefix are compiled
# into the app and readable by anyone who has the APK: only public settings here.
# Never WordPress passwords, API secrets or Firebase service-account keys.

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# The WordPress site the app reads from (HTTPS only).
EXPO_PUBLIC_SITE_URL=https://allbiohub.com
# Read-only startup directory API on that site (../API.md).
EXPO_PUBLIC_STARTUP_API_PATH=/wp-json/allbiohub/v1

EXPO_PUBLIC_PRIVACY_POLICY_URL=https://allbiohub.com/privacy-policy/
EXPO_PUBLIC_TERMS_URL=https://allbiohub.com/terms-and-conditions/
EXPO_PUBLIC_CONTACT_EMAIL=hello@allbiohub.com

# --- Build-time only (read by app.config.ts, not shipped as EXPO_PUBLIC) ---
# Path to the Firebase Android client file. Push notifications are switched on
# only when this file exists at build time. CI writes it from the FIREBASE_*
# Actions secrets (tool/write-google-services.mjs).
GOOGLE_SERVICES_FILE=./google-services.json
