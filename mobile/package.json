  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.0",
    "typescript": "~6.0.3"
