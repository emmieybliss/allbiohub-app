# AllBioHub app configuration. Copy to .env.dev or .env.prod (both
# git-ignored) and pass it to Flutter:
#   flutter run --dart-define-from-file=.env.dev
#   flutter build apk --release --dart-define-from-file=.env.prod
#
# Values are compiled into the app and readable by anyone who has the APK.
# Only public configuration belongs here: never WordPress admin passwords,
# API secrets, payment keys or Firebase service-account keys.

APP_ENV=production

# The WordPress site the app reads from (HTTPS only).
WORDPRESS_BASE_URL=https://allbiohub.com
# Read-only startup directory API on that site (see API.md).
STARTUP_API_PATH=/wp-json/allbiohub/v1

# Shown in Profile. Leave empty to hide the entry.
PRIVACY_POLICY_URL=https://allbiohub.com/privacy-policy/
TERMS_URL=https://allbiohub.com/terms-and-conditions/
CONTACT_EMAIL=hello@allbiohub.com

# Firebase client settings for notifications and analytics (README →
# Firebase). These are public client identifiers, not secrets. Leave empty
# to keep notifications and analytics off.
FIREBASE_PROJECT_ID=allbiohub-d8015
FIREBASE_API_KEY=AIzaSyAjZamsNW1WDIomZQjMxEM9SgOeBvKTy0Q
FIREBASE_APP_ID=1:913402716970:android:22da94c7d658e1959f3453
FIREBASE_MESSAGING_SENDER_ID=913402716970
