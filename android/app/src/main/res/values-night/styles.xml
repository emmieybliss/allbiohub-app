<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the app process starts, until Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/brand_black</item>
        <item name="android:navigationBarColor">@color/brand_black</item>
    </style>
    <!-- Window behind the Flutter UI. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/brand_black</item>
    </style>
</resources>
