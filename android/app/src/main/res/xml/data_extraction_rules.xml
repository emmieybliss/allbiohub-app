<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up saved stories and settings; skip the API cache. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter/api_cache.hive" />
        <exclude domain="root" path="app_flutter/api_cache.lock" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter/api_cache.hive" />
        <exclude domain="root" path="app_flutter/api_cache.lock" />
    </device-transfer>
</data-extraction-rules>
